# All optional — defaults target the team minipc via mDNS (dminipc.local,
# works regardless of which IP the hotspot assigns). Copy to .env.local
# to override.

# NASA POWER backend (see docs/backend/deployment.md)
# VITE_POWER_API_BASE=http://dminipc.local:8080

# OpenStreetMap tile server (see docs/ops/minipc.md)
# VITE_TILES_BASE=http://dminipc.local:8081
